; Zindan Oyunu — Godot proje ayarları.
; Bu dosya Godot editörü tarafından da düzenlenebilir.

config_version=5

[application]

config/name="Zindan Oyunu"
config/description="2D izometrik roguelike zindan oyunu"
config/version="0.3.1"
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Events="*res://scripts/autoload/events.gd"
DataDB="*res://scripts/autoload/data_db.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

